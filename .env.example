# ========================================================
# Order Management System - Environment Variables Template
# ========================================================

# Backend Server Configuration
SERVER_PORT=8050

# Database Connection (External MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/soataskdb
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# JPA / Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend API Configuration (for Vite React app)
VITE_API_BASE_URL=http://localhost:8050
